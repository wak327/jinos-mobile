#!/bin/sh
# Laptop: assemble jinos-laptop.iso, a UEFI live ISO that also works when
# written to a USB stick (hybrid: GPT with an EFI partition).
#   EFI/efiboot.img (El Torito image, also the GPT EFI partition):
#     EFI/BOOT/BOOTX64.EFI = the live UKI
#   LiveOS/squashfs.img: holds LiveOS/rootfs.img, the image's root filesystem
set -eu
cd "$OUTPUTDIR"
iso=$IMAGE_ID.iso
work=$(mktemp -d "$OUTPUTDIR/.iso.XXXXXX")
trap 'rm -rf "$work"' EXIT

# The root partition of the disk image, as a file.
start=; size=
eval "$(sfdisk -J "$IMAGE_ID.raw" | python3 -c '
import json, sys
for p in json.load(sys.stdin)["partitiontable"]["partitions"]:
    if p["type"].upper() == "4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709":
        print("start=%d size=%d" % (p["start"], p["size"]))
')"
mkdir -p "$work/squash/LiveOS" "$work/iso/LiveOS"
dd if="$IMAGE_ID.raw" of="$work/squash/LiveOS/rootfs.img" bs=4M \
    skip=$((start * 512)) count=$((size * 512)) iflag=skip_bytes,count_bytes status=none
[ -s "$work/squash/LiveOS/rootfs.img" ] || { echo "postoutput: couldn't extract the root partition" >&2; exit 1; }
mksquashfs "$work/squash" "$work/iso/LiveOS/squashfs.img" -comp zstd -Xcompression-level 15 -quiet -no-progress
rm "$work/squash/LiveOS/rootfs.img"

# EFI system partition image with the live UKI as the default boot loader.
# It lives inside the ISO filesystem: firmware finds an El Torito image's
# size from the ISO's extent when the image is too big to give its size
# (over 32 MB), so it must not be appended after the filesystem.
uki=$IMAGE_ID.live.efi
esp_kb=$(( ($(stat -c %s "$uki") / 1024) + 4096 ))
mkdir -p "$work/iso/EFI"
esp=$work/iso/EFI/efiboot.img
truncate -s "${esp_kb}K" "$esp"
mkfs.vfat -n JINOS-EFI "$esp" >/dev/null
mmd -i "$esp" ::/EFI ::/EFI/BOOT
mcopy -i "$esp" "$uki" ::/EFI/BOOT/BOOTX64.EFI

xorriso -as mkisofs -o "$iso" -quiet \
    -iso-level 3 -full-iso9660-filenames -joliet -joliet-long -rational-rock \
    -volid JINOS \
    -e EFI/efiboot.img -no-emul-boot \
    -efi-boot-part --efi-boot-image \
    "$work/iso"
rm "$uki"
echo "ISO: $iso ($(du -h "$iso" | cut -f1))"
